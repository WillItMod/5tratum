[Unit]
Description=5tratumOS Console (kiosk) for %i
After=network-online.target 5tratumos-overlay.service 5tratumosd.service
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=%i
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=TRATUMOS_CONSOLE_URL=http://127.0.0.1/
Environment=TRATUMOS_CONSOLE_HEALTH_URL=http://127.0.0.1/
Environment=TRATUMOS_CONSOLE_WAIT_SECS=90
ExecCondition=/bin/bash -lc 'test -e /dev/dri/card0 -o -e /dev/fb0'
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
KillMode=mixed
ExecStart=/usr/local/bin/5tratumos-console

[Install]
WantedBy=multi-user.target
