[Unit]
Description=5tratumOS Console (kiosk) for %i
After=network-online.target 5tratumos-overlay.service 5tratumosd.service
Wants=network-online.target

[Service]
Type=simple
User=%i
PAMName=login
PermissionsStartOnly=yes
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=TRATUMOS_CONSOLE_URL=http://127.0.0.1/login.html
Environment=TRATUMOS_CONSOLE_HEALTH_URL=http://127.0.0.1/login.html
Environment=TRATUMOS_CONSOLE_WAIT_SECS=90
Environment=TRATUMOS_CONSOLE_VT=7
Environment=TRATUMOS_CONSOLE_AUTO_CHVT=1
Restart=on-failure
RestartSec=2
TimeoutStopSec=8
KillMode=mixed
# Do NOT use ExecCondition for GPU/VT gating: if it fails once at boot (udev timing),
# systemd marks the unit "skipped" and it will never retry. Use ExecStartPre to wait
# and let Restart= handle retries.
StartLimitIntervalSec=0

# Ensure the runtime dir exists early (PAM/logind can race at boot for system services).
ExecStartPre=/usr/bin/install -d -m 0700 -o %U -g %G /run/user/%U

# Wait for basic graphics devices to appear (when available). In VMs, allow X11 fallback.
ExecStartPre=/bin/bash -lc 'if systemd-detect-virt -q; then exit 0; fi; for i in $(seq 1 30); do test -e /dev/dri/card0 -o -e /dev/fb0 && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/local/bin/5tratumos-console
ExecStartPost=/usr/local/bin/5tratumos-console-vt-switch start %i
ExecStopPost=/usr/local/bin/5tratumos-console-vt-switch stop

[Install]
WantedBy=multi-user.target
