[Unit]
Description=5tratumOS Console (kiosk) for %i
After=network-online.target forgeos-overlay.service forgeosd.service
Wants=network-online.target
Conflicts=getty@tty1.service
After=getty@tty1.service
ConditionPathExists=/dev/dri/card0

[Service]
Type=simple
User=%i
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=FORGEOS_CONSOLE_URL=http://127.0.0.1/
Environment=FORGEOS_CONSOLE_HEALTH_URL=http://127.0.0.1/api/v0/health
Environment=FORGEOS_CONSOLE_WAIT_SECS=90
Restart=on-failure
RestartSec=2
ExecStart=/usr/local/bin/forgeos-console

[Install]
WantedBy=multi-user.target
