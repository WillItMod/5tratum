[Unit]
Description=5tratumOS First Boot App Store Sync
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/etc/5tratumos/firstboot-store-sync.done

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/5tratumos/bootstrap/firstboot-store-sync.sh
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target

