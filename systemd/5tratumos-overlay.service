[Unit]
Description=5tratumOS overlay (Docker Compose)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/5tratumos/overlay
ExecStart=/bin/bash /opt/5tratumos/bootstrap/overlay-up.sh up
ExecStop=/bin/bash /opt/5tratumos/bootstrap/overlay-up.sh down
Restart=on-failure
RestartSec=10
TimeoutStartSec=240

[Install]
WantedBy=multi-user.target
