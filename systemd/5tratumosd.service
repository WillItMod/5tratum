[Unit]
Description=5tratumOS daemon (API)
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/5tratumos/daemon
ExecStart=/usr/bin/python3 /opt/5tratumos/daemon/5tratumosd.py --host 127.0.0.1 --port 9000
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
