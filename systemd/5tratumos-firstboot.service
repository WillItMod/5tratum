[Unit]
Description=5tratumOS First Boot Tasks
After=local-fs.target
Before=ssh.service
Before=5tratumosd.service
ConditionPathExists=!/etc/5tratumos/firstboot.done

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/5tratumos/bootstrap/firstboot.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
