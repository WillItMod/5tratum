import os
import time
from pathlib import Path

app_dir = Path(os.environ.get("APP_DIR") or "")
meta_file = Path(os.environ.get("META_FILE") or "")
target = (os.environ.get("TARGET_VERSION") or "").strip()
current_backup = (os.environ.get("CURRENT_BACKUP") or "").strip()

