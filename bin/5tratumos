    if not k.strip("|"):
        continue
    if k in seen:
        continue
    seen.add(k)
    dedup.append(item)

obj["installed_version"] = target
obj["updated_at"] = now
obj["rollbacks"] = dedup[:10]
meta_file.write_text(json.dumps(obj, separators=(",", ":"), ensure_ascii=False), encoding="utf-8")
PY

        project="$(app_project_name "${app_id}")"
        compose_up "${project}" "${app_dir}" pull
        compose_up "${project}" "${app_dir}" up -d --remove-orphans
        echo "rolled back ${app_id} to ${to}"
        ;;
      uninstall)
        app_id="${1:-}"; shift || true
        [ -n "${app_id}" ] || die "missing app id"
        purge="false"
        if [ "${1:-}" = "--purge" ]; then
          purge="true"
          shift || true
        fi
        app_dir="${ROOT_DIR}/apps/${app_id}"
        [ -d "${app_dir}" ] || die "app not installed: ${app_id} (${app_dir})"

        project="$(app_project_name "${app_id}")"
        (cd "${app_dir}" && docker compose --project-name "${project}" down --remove-orphans) || true

        rm -rf "${app_dir}"
        if [ "${purge}" = "true" ]; then
          rm -rf "${STATE_DIR}/apps/${app_id}"
          echo "uninstalled ${app_id} (purged)"
        else
          echo "uninstalled ${app_id}"
        fi
        ;;
      up|down|pull|logs)
        action="${sub}"
        app_id="${1:-}"; shift || true
        [ -n "${app_id}" ] || die "missing app id"
        app_dir="${ROOT_DIR}/apps/${app_id}"
        [ -d "${app_dir}" ] || die "app not installed: ${app_id} (${app_dir})"
        project="$(app_project_name "${app_id}")"
        case "${action}" in
          up)
            compose_up "${project}" "${app_dir}" up -d
            ;;
          down)
            compose_up "${project}" "${app_dir}" down
            ;;
          pull)
            compose_up "${project}" "${app_dir}" pull
            ;;
          logs)
            compose_up "${project}" "${app_dir}" logs --tail=200 -f
            ;;
        esac
        ;;
      *)
        die "unknown subcommand: app ${sub:-}"
        ;;
    esac
    ;;

  *)
    die "unknown command: ${cmd}"
    ;;
esac
