#!/usr/bin/env bash
set -euo pipefail

legacy_brand() { printf '%s' f o r g e o s; }
legacy_upper() { printf '%s' F O R G E O S; }
legacy_env() {
  local suffix="$1"
  local k
  k="$(legacy_upper)_${suffix}"
  printf '%s' "${!k-}"
}

ROOT_DIR="${FIVETRATUMOS_ROOT:-$(legacy_env ROOT)}"
ROOT_DIR="${ROOT_DIR:-/opt/5tratumos}"
STATE_DIR="${FIVETRATUMOS_STATE_DIR:-$(legacy_env STATE_DIR)}"
STATE_DIR="${STATE_DIR:-/var/lib/5tratumos}"
CHANNEL_FILE="${FIVETRATUMOS_CHANNEL_FILE:-$(legacy_env CHANNEL_FILE)}"
CHANNEL_FILE="${CHANNEL_FILE:-/etc/5tratumos/channel}"

die() {
  echo "error: $*" >&2
  exit 1
}

have() { command -v "$1" >/dev/null 2>&1; }

current_channel() {
  if [ -n "${FIVETRATUMOS_CHANNEL:-}" ]; then
    echo "${FIVETRATUMOS_CHANNEL}"
    return 0
  fi
  legacy_ch="$(legacy_env CHANNEL)"
  if [ -n "${legacy_ch}" ]; then
    echo "${legacy_ch}"
    return 0
  fi
  if [ -f "${CHANNEL_FILE}" ]; then
    tr -d ' \t\r\n' <"${CHANNEL_FILE}" || true
    return 0
  fi
  echo "main"
}

require_docker() {
  have docker || die "docker not found (install Docker Engine + Compose v2)"
  docker info >/dev/null 2>&1 || die "docker is not accessible (is the daemon running? permissions?)"
  docker compose version >/dev/null 2>&1 || die "docker compose not available (install docker-compose-plugin)"
}

ensure_dirs() {
  mkdir -p "${ROOT_DIR}/overlay" "${ROOT_DIR}/apps" "${ROOT_DIR}/apps-available"
  mkdir -p "${STATE_DIR}/apps"
}

compose_up() {
  local project="$1"
  local workdir="$2"
  shift 2
  (cd "${workdir}" && docker compose --project-name "${project}" "$@")
}

app_meta_file() {
  local app_dir="$1"
  local new_path="${app_dir}/5tratumos.json"
  local legacy_path="${app_dir}/$(legacy_brand).json"
  if [ -f "${new_path}" ]; then
    echo "${new_path}"
    return 0
  fi
  if [ -f "${legacy_path}" ]; then
    echo "${legacy_path}"
    return 0
  fi
  echo "${new_path}"
}

app_project_name() {
  local app_id="$1"
  local new_project="5tratumos-${app_id}"
  local legacy_project="$(legacy_brand)-${app_id}"
  local bare_project="${app_id}"
  if docker ps -a --filter "label=com.docker.compose.project=${new_project}" --format '{{.ID}}' | grep -q .; then
    echo "${new_project}"
    return 0
  fi
  if docker ps -a --filter "label=com.docker.compose.project=${legacy_project}" --format '{{.ID}}' | grep -q .; then
    echo "${legacy_project}"
    return 0
  fi
  if docker ps -a --filter "label=com.docker.compose.project=${bare_project}" --format '{{.ID}}' | grep -q .; then
    echo "${bare_project}"
    return 0
  fi
  echo "${new_project}"
}

usage() {
  cat <<'EOF'
5tratumos: manage 5tratumOS overlay + AxeSuite apps (Docker Compose)

Usage:
  5tratumos channel get
  5tratumos channel set <main|dev>

  5tratumos store sync [main|dev|global|all]

  5tratumos overlay up
  5tratumos overlay down
  5tratumos overlay logs
  5tratumos overlay status

  5tratumos app available
  5tratumos app installed
  5tratumos app install <app-id> [--channel <main|dev>]
  5tratumos app update <app-id> [--channel <main|dev|global>]
  5tratumos app rollback <app-id> --to <version>
  5tratumos app uninstall <app-id> [--purge]
  5tratumos app up <app-id>
  5tratumos app down <app-id>
  5tratumos app pull <app-id>
  5tratumos app logs <app-id>
EOF
}

cmd="${1:-}"
shift || true

case "${cmd}" in
  ""|-h|--help|help)
    usage
    exit 0
    ;;
esac

ensure_dirs

case "${cmd}" in
  channel)
    sub="${1:-}"; shift || true
    case "${sub}" in
      get)
        current_channel
        ;;
      set)
        [ "${EUID:-$(id -u)}" -eq 0 ] || die "channel set requires root (writes ${CHANNEL_FILE})"
        ch="${1:-}"
        [ -n "${ch}" ] || die "missing channel (main|dev)"
        case "${ch}" in
          main|dev) ;;
          *) die "invalid channel: ${ch} (expected main|dev)" ;;
        esac
        install -d -m 0755 "$(dirname "${CHANNEL_FILE}")"
        printf "%s\n" "${ch}" >"${CHANNEL_FILE}"
        echo "${ch}"
        ;;
      *)
        die "unknown subcommand: channel ${sub:-}"
        ;;
    esac
    ;;

  store)
    sub="${1:-}"; shift || true
    case "${sub}" in
      sync)
        [ "${EUID:-$(id -u)}" -eq 0 ] || die "store sync requires root (writes ${ROOT_DIR}/store)"
        have curl || die "curl not found (install curl)"
        have tar || die "tar not found"

        target="${1:-all}"
        case "${target}" in
          ""|all|main|dev|global) ;;
          *) die "invalid store sync target: ${target} (expected main|dev|global|all)" ;;
        esac

        store_base="${ROOT_DIR}/store"
        mkdir -p "${store_base}"

        sync_one() {
          local ch="$1"
          local url="$2"
          local url_fallback="${3:-}"
          local dest="${store_base}/${ch}"
          local tmp="${store_base}/.tmp-${ch}-$$"

          rm -rf "${tmp}"
          mkdir -p "${tmp}"

          echo "syncing store (${ch})..."
          if ! curl -fsSL "${url}" | tar -xz -C "${tmp}" --strip-components=1; then
            [ -n "${url_fallback}" ] || die "failed to download store from ${url}"
            rm -rf "${tmp}"
            mkdir -p "${tmp}"
            echo "primary store URL failed; trying fallback..."
            curl -fsSL "${url_fallback}" | tar -xz -C "${tmp}" --strip-components=1
          fi

          # Normalize third-party manifests to a 5tratumOS-friendly name.
          find "${tmp}" -type f -name '*-app.yml' -print0 2>/dev/null | while IFS= read -r -d '' f; do
            [ "$(basename "${f}")" = "global-app.yml" ] && continue
            mv -f "${f}" "$(dirname "${f}")/global-app.yml" || true
          done

          rm -rf "${dest}"
          mv "${tmp}" "${dest}"
        }

        sync_global_assets() {
          [ "${FIVETRATUMOS_GLOBAL_ASSETS_DISABLE:-}" = "1" ] && return 0
          local repo="${FIVETRATUMOS_GLOBAL_ASSETS_REPO:-}"
          repo="${repo:-$(legacy_env GLOBAL_ASSETS_REPO)}"
          repo="${repo:-WillItMod/global-apps-gallery}"
          local branch="${FIVETRATUMOS_GLOBAL_ASSETS_BRANCH:-}"
          branch="${branch:-$(legacy_env GLOBAL_ASSETS_BRANCH)}"
          branch="${branch:-master}"

          local url_default="https://github.com/${repo}/archive/refs/heads/${branch}.tar.gz"
          local url="${FIVETRATUMOS_GLOBAL_ASSETS_URL:-}"
          url="${url:-$(legacy_env GLOBAL_ASSETS_URL)}"
          url="${url:-${url_default}}"

          local url_fallback=""
          if [ -z "${FIVETRATUMOS_GLOBAL_ASSETS_URL:-}" ] && [ -z "$(legacy_env GLOBAL_ASSETS_URL)" ]; then
            if [ "${branch}" = "master" ]; then
              url_fallback="https://github.com/${repo}/archive/refs/heads/main.tar.gz"
            elif [ "${branch}" = "main" ]; then
              url_fallback="https://github.com/${repo}/archive/refs/heads/master.tar.gz"
            fi
          fi

          local ch="global-assets"
          local dest="${store_base}/${ch}"
          local tmp="${store_base}/.tmp-${ch}-$$"

          rm -rf "${tmp}"
          mkdir -p "${tmp}"

          echo "syncing store assets (${repo}@${branch})..."
          if ! curl -fsSL "${url}" | tar -xz -C "${tmp}" --strip-components=1; then
            [ -n "${url_fallback}" ] || die "failed to download global assets from ${url}"
            rm -rf "${tmp}"
            mkdir -p "${tmp}"
            echo "primary assets URL failed; trying fallback..."
            curl -fsSL "${url_fallback}" | tar -xz -C "${tmp}" --strip-components=1
          fi

          rm -rf "${dest}"
          mv "${tmp}" "${dest}"
        }

        main_repo="u""mbrel-community-store"
        dev_repo="u""mbrel-dev-community-store"
        main_url="https://github.com/WillItMod/${main_repo}/archive/refs/heads/main.tar.gz"
        main_url_fallback="https://github.com/WillItMod/${main_repo}/archive/refs/heads/master.tar.gz"
        dev_url="https://github.com/WillItMod/${dev_repo}/archive/refs/heads/main.tar.gz"
        dev_url_fallback="https://github.com/WillItMod/${dev_repo}/archive/refs/heads/master.tar.gz"
        global_repo="${FIVETRATUMOS_GLOBAL_STORE_REPO:-}"
        global_repo="${global_repo:-$(legacy_env GLOBAL_STORE_REPO)}"
        global_repo="${global_repo:-WillItMod/global-apps}"
        global_branch="${FIVETRATUMOS_GLOBAL_STORE_BRANCH:-}"
        global_branch="${global_branch:-$(legacy_env GLOBAL_STORE_BRANCH)}"
        global_branch="${global_branch:-master}"
        global_url_default="https://github.com/${global_repo}/archive/refs/heads/${global_branch}.tar.gz"
        global_url="${FIVETRATUMOS_GLOBAL_STORE_URL:-}"
        global_url="${global_url:-$(legacy_env GLOBAL_STORE_URL)}"
        global_url="${global_url:-${global_url_default}}"
        global_url_fallback=""
        if [ -z "${FIVETRATUMOS_GLOBAL_STORE_URL:-}" ] && [ -z "$(legacy_env GLOBAL_STORE_URL)" ]; then
          if [ "${global_branch}" = "master" ]; then
            global_url_fallback="https://github.com/${global_repo}/archive/refs/heads/main.tar.gz"
          elif [ "${global_branch}" = "main" ]; then
            global_url_fallback="https://github.com/${global_repo}/archive/refs/heads/master.tar.gz"
          fi
        fi

        if [ "${target}" = "all" ] || [ -z "${target}" ]; then
          sync_one "main" "${main_url}" "${main_url_fallback}"
          sync_one "dev" "${dev_url}" "${dev_url_fallback}"
          sync_one "global" "${global_url}" "${global_url_fallback}"
          sync_global_assets
        elif [ "${target}" = "main" ]; then
          sync_one "main" "${main_url}" "${main_url_fallback}"
        elif [ "${target}" = "global" ]; then
          sync_one "global" "${global_url}" "${global_url_fallback}"
          sync_global_assets
        else
          sync_one "dev" "${dev_url}" "${dev_url_fallback}"
        fi

        echo "store synced: ${store_base}"
        ;;
      *)
        die "unknown subcommand: store ${sub:-}"
        ;;
    esac
    ;;

  overlay)
    require_docker
    sub="${1:-}"; shift || true
    case "${sub}" in
      up)
        compose_up "5tratumos-overlay" "${ROOT_DIR}/overlay" up -d
        ;;
      down)
        compose_up "5tratumos-overlay" "${ROOT_DIR}/overlay" down
        ;;
      logs)
        compose_up "5tratumos-overlay" "${ROOT_DIR}/overlay" logs --tail=200 -f
        ;;
      status)
        compose_up "5tratumos-overlay" "${ROOT_DIR}/overlay" ps
        ;;
      *)
        die "unknown subcommand: overlay ${sub:-}"
        ;;
    esac
    ;;

  app)
    require_docker
    sub="${1:-}"; shift || true
    case "${sub}" in
      available)
        ch="$(current_channel)"
        avail_dir="${ROOT_DIR}/apps-available/${ch}"
        [ -d "${avail_dir}" ] || die "no available apps for channel '${ch}' in ${avail_dir}"
        (cd "${avail_dir}" && ls -1) || true
        ;;
      installed)
        (cd "${ROOT_DIR}/apps" && ls -1) || true
        ;;
      install)
        app_id="${1:-}"; shift || true
        [ -n "${app_id}" ] || die "missing app id"
        ch="$(current_channel)"
        if [ "${1:-}" = "--channel" ]; then
          shift
          ch="${1:-}"
          shift || true
        fi
        [ -n "${ch}" ] || die "missing channel value"
        store_root="${ROOT_DIR}/store/${ch}"
        store_dir=""
        store_port=""
        dst="${ROOT_DIR}/apps/${app_id}"
        [ ! -e "${dst}" ] || die "app already installed: ${app_id} (${dst})"

        install -d -m 0755 "${dst}"

        src="${ROOT_DIR}/apps-available/${ch}/${app_id}"
        if [ -d "${src}" ]; then
          cp -a "${src}/." "${dst}/"
        else
          [ -d "${store_root}" ] || die "store not found: ${store_root} (run: sudo 5tratumos store sync ${ch})"

          resolved="$(
            TARGET_APP_ID="${app_id}" STORE_ROOT="${store_root}" python3 - <<'PY'
import os
import sys
from pathlib import Path

try:
    import yaml  # type: ignore
except Exception:
    print("", file=sys.stderr)
    sys.exit(2)

target = (os.environ.get("TARGET_APP_ID") or "").strip().lower()
root = Path(os.environ.get("STORE_ROOT") or "")
if not target or not root.is_dir():
    sys.exit(1)

def map_store_id_to_app_id(store_id: str) -> str:
    raw = (store_id or "").strip().lower()
    # Global store uses canonical IDs like "bitcoin", "nextcloud", etc.
    if root.name.strip().lower() == "global":
        raw = raw.replace(" ", "-")
        raw = "".join(ch for ch in raw if ch.isalnum() or ch in {"_", "-"})
        return raw or "app"
    for prefix in ("willitmod-dev-", "willitmod-"):
        if raw.startswith(prefix):
            raw = raw[len(prefix) :]
            break
    raw = raw.replace("_", "").replace("-", "")
    if not raw.startswith("axe"):
        raw = f"axe{raw}"
    return raw

for entry in sorted(root.iterdir(), key=lambda p: p.name):
    if not entry.is_dir():
        continue
    if entry.name.startswith("."):
        continue
    manifest_path = entry / "global-app.yml"
    compose_path = entry / "docker-compose.yml"
    if not manifest_path.is_file() or not compose_path.is_file():
        continue
    try:
        manifest = yaml.safe_load(manifest_path.read_text(encoding="utf-8")) or {}
    except Exception:
        continue
    store_id = str(manifest.get("id") or entry.name)
    app_id = map_store_id_to_app_id(store_id)
    if app_id != target:
        continue
    port = manifest.get("port") or ""
    print(f"{entry.name}\t{port}")
    sys.exit(0)

sys.exit(1)
PY
          )"

          [ -n "${resolved}" ] || die "no store recipe for '${app_id}' on channel '${ch}' (missing ${src})"
          store_dir="$(printf '%s' "${resolved}" | awk -F '\t' '{print $1}')"
          store_port="$(printf '%s' "${resolved}" | awk -F '\t' '{print $2}')"

          gen_ok="$(
            STORE_ROOT="${store_root}" STORE_DIR="${store_dir}" STORE_PORT="${store_port}" DEST="${dst}" APP_ID="${app_id}" python3 - <<'PY'
import os
import sys
from pathlib import Path

try:
    import yaml  # type: ignore
except Exception:
    sys.exit(2)

root = Path(os.environ.get("STORE_ROOT") or "")
store_dir = os.environ.get("STORE_DIR") or ""
dest = Path(os.environ.get("DEST") or "")
app_id = (os.environ.get("APP_ID") or "").strip().lower()
port_raw = (os.environ.get("STORE_PORT") or "").strip()

try:
    port = int(port_raw) if port_raw else 0
except ValueError:
    port = 0

compose_path = root / store_dir / "docker-compose.yml"
manifest_path = root / store_dir / "global-app.yml"
if not compose_path.is_file() or not dest.is_dir():
    sys.exit(1)

compose = yaml.safe_load(compose_path.read_text(encoding="utf-8")) or {}
if not isinstance(compose, dict):
    compose = {}

manifest = {}
if manifest_path.is_file():
    try:
        manifest = yaml.safe_load(manifest_path.read_text(encoding="utf-8")) or {}
    except Exception:
        manifest = {}

host_port = port
if not host_port:
    try:
        host_port = int(str(manifest.get("port") or "").strip() or "0")
    except Exception:
        host_port = 0

services = compose.get("services") or {}
if not isinstance(services, dict):
    services = {}

def env_to_dict(env):
    if isinstance(env, dict):
        out = {}
        for k, v in env.items():
            ks = str(k).strip()
            if not ks:
                continue
            out[ks] = "" if v is None else str(v)
        return out
    if isinstance(env, list):
        out = {}
        for item in env:
            s = "" if item is None else str(item)
            if "=" not in s:
                continue
            k, v = s.split("=", 1)
            k = k.strip()
            if not k:
                continue
            out[k] = v
        return out
    return {}

def parse_port_entry(entry):
    raw = "" if entry is None else str(entry)
    raw = raw.strip()
    if not raw:
        return None, None
    base = raw.split("/", 1)[0]
    parts = base.split(":")
    try:
        if len(parts) == 1:
            return None, int(parts[0])
        if len(parts) == 2:
            return int(parts[0]), int(parts[1])
        if len(parts) >= 3:
            return int(parts[-2]), int(parts[-1])
    except Exception:
        return None, None
    return None, None

def ensure_port_mapping(svc, host, container):
    if not isinstance(svc, dict) or not host or not container:
        return
    ports = svc.get("ports")
    if not isinstance(ports, list):
        ports = [] if ports in (None, "") else [ports]
    for entry in ports:
        h, _ = parse_port_entry(entry)
        if h == host:
            return
    ports.append(f"{host}:{container}")
    svc["ports"] = ports

app_proxy = services.get("app_proxy") if isinstance(services.get("app_proxy"), dict) else None
proxy_env = env_to_dict(app_proxy.get("environment") if app_proxy else None)
app_host = str(proxy_env.get("APP_HOST") or "").strip()
app_port_raw = str(proxy_env.get("APP_PORT") or "").strip()
try:
    app_port = int(app_port_raw) if app_port_raw else 0
except Exception:
    app_port = 0

services.pop("app_proxy", None)

# Remove any leftover dependencies on legacy app proxies.
for _name, _svc in list(services.items()):
    if not isinstance(_svc, dict):
        continue
    deps = _svc.get("depends_on")
    if isinstance(deps, list):
        deps2 = [d for d in deps if str(d).strip() != "app_proxy"]
        if deps2:
            _svc["depends_on"] = deps2
        else:
            _svc.pop("depends_on", None)
    elif isinstance(deps, dict) and "app_proxy" in deps:
        deps.pop("app_proxy", None)
        if deps:
            _svc["depends_on"] = deps
        else:
            _svc.pop("depends_on", None)
    services[_name] = _svc

def find_ui_service(services, host):
    host = (host or "").strip()
    if not host:
        return None
    if host in services:
        return host
    for name, svc in services.items():
        if not isinstance(svc, dict):
            continue
        if str(svc.get("container_name") or "").strip() == host:
            return name
        nets = svc.get("networks")
        if isinstance(nets, dict):
            for _, cfg in nets.items():
                if not isinstance(cfg, dict):
                    continue
                aliases = cfg.get("aliases")
                if isinstance(aliases, list) and host in [str(a).strip() for a in aliases]:
                    return name
    return None

ui_service = find_ui_service(services, app_host) or ("app" if "app" in services else None)
if not ui_service and services:
    ui_service = next(iter(services.keys()))

if host_port and ui_service:
    svc = services.get(ui_service) or {}
    if isinstance(svc, dict):
        ensure_port_mapping(svc, host_port, app_port or host_port)
        services[ui_service] = svc

compose["services"] = services

# Remove legacy compose version to avoid warnings.
compose.pop("version", None)

# Strip legacy shared networks if present; allow Compose default network instead.
def should_drop_network(net_name: object, cfg: object) -> bool:
    n = str(net_name or "").strip()
    if n.endswith("_main_network"):
        return True
    if isinstance(cfg, dict):
        cn = str(cfg.get("name") or "").strip()
        if cn.endswith("_main_network"):
            return True
    return False

drop_networks: set[str] = set()
networks = compose.get("networks")
if isinstance(networks, dict):
    drop = []
    for net_name, cfg in networks.items():
        if should_drop_network(net_name, cfg):
            drop.append(net_name)
    for net_name in drop:
        networks.pop(net_name, None)
    for net_name in drop:
        nn = str(net_name).strip()
        if nn and nn != "default":
            drop_networks.add(nn)
    if not networks:
        compose.pop("networks", None)
    else:
        compose["networks"] = networks

for name, svc in list(services.items()):
    if not isinstance(svc, dict):
        continue
    nets = svc.get("networks")
    if isinstance(nets, list):
        nets2 = [n for n in nets if str(n).strip() not in drop_networks]
        if nets2:
            svc["networks"] = nets2
        else:
            svc.pop("networks", None)
    elif isinstance(nets, dict):
        for dn in list(nets.keys()):
            if str(dn).strip() in drop_networks:
                nets.pop(dn, None)
        if nets:
            svc["networks"] = nets
        else:
            svc.pop("networks", None)
    services[name] = svc

out_path = dest / "docker-compose.yml"
out_path.write_text(yaml.safe_dump(compose, sort_keys=False), encoding="utf-8")
sys.exit(0)
PY
          )"

          [ $? -eq 0 ] || die "failed to generate compose from store for ${app_id}"
        fi

        app_state_dir="${STATE_DIR}/apps/${app_id}"
        install -d -m 0755 "${app_state_dir}/data"

        # Seed app data payloads from the store recipe (templates/defaults).
        store_data_dir="${store_root}/${store_dir}/data"
        if [ -d "${store_data_dir}" ]; then
          cp -an "${store_data_dir}/." "${app_state_dir}/data/" 2>/dev/null || true
        fi

        persist_env="${app_state_dir}/.env"
        if [ ! -f "${persist_env}" ]; then
          jwt_secret="$(python3 - <<'PY'
import secrets
print(secrets.token_urlsafe(48))
PY
)"
          app_password="$(python3 - <<'PY'
import secrets
print(secrets.token_urlsafe(18))
PY
)"
          # Default to a private-range base so templates that derive APP_SUBNET="${NETWORK_IP}/16"
          # stay syntactically valid even when 5tratumOS uses per-project networks.
          cat >"${persist_env}" <<EOF
NETWORK_IP=172.16.0.0
APP_PASSWORD=${app_password}
JWT_SECRET=${jwt_secret}
EOF
          chmod 600 "${persist_env}" 2>/dev/null || true
        fi

        # Compose interpolation reads .env in the project directory; include persistent secrets.
        cat >"${dst}/.env" <<EOF
APP_DATA_DIR=${app_state_dir}
EOF
        cat "${persist_env}" >>"${dst}/.env"
        chmod 600 "${dst}/.env" 2>/dev/null || true

        # Templates commonly run as uid/gid 1000; ensure the app data dir is writable.
        if [ "${EUID:-$(id -u)}" -eq 0 ]; then
          chown -R 1000:1000 "${app_state_dir}" 2>/dev/null || true
        fi

        meta_file="${dst}/5tratumos.json"
        STORE_ROOT="${store_root}" STORE_DIR="${store_dir}" CHANNEL="${ch}" APP_ID="${app_id}" APP_DIR="${dst}" python3 - <<'PY' >"${meta_file}"
import json
import os
import time
from pathlib import Path

try:
    import yaml  # type: ignore
except Exception:
    yaml = None


def image_tag(image: str) -> str:
    raw = (image or "").strip()
    if not raw:
        return ""
    base = raw.split("@", 1)[0]
    idx = base.rfind(":")
    if idx <= base.rfind("/"):
        return ""
    tag = base[idx + 1 :].strip()
    if not tag or tag.lower() == "latest":
        return ""
    return tag


app_id = (os.environ.get("APP_ID") or "").strip().lower()
channel = (os.environ.get("CHANNEL") or "").strip().lower()
store_root = Path(os.environ.get("STORE_ROOT") or "")
