    obj = json.loads(meta_file.read_text(encoding="utf-8") or "{}")
except Exception:
    obj = {}
if not isinstance(obj, dict):
    obj = {}

rollbacks = obj.get("rollbacks")
rollbacks = [x for x in rollbacks if isinstance(x, dict)] if isinstance(rollbacks, list) else []

