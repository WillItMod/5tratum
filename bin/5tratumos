import json
import os
import time
from pathlib import Path

app_dir = Path(os.environ.get("APP_DIR") or "")
meta_file = Path(os.environ.get("META_FILE") or "")
target = (os.environ.get("TARGET_VERSION") or "").strip()
current_backup = (os.environ.get("CURRENT_BACKUP") or "").strip()

if not app_dir.is_dir() or not meta_file.is_file() or not target:
    raise SystemExit(2)

obj = {}
try:
    obj = json.loads(meta_file.read_text(encoding="utf-8") or "{}")
except Exception:
    obj = {}
if not isinstance(obj, dict):
    obj = {}

rollbacks = obj.get("rollbacks")
rollbacks = [x for x in rollbacks if isinstance(x, dict)] if isinstance(rollbacks, list) else []

picked = None
for rb in rollbacks:
    if str(rb.get("version") or "").strip() == target:
        picked = rb
        break

if not picked:
    raise SystemExit(3)

compose_fn = str(picked.get("compose") or "").strip()
compose_path = app_dir / compose_fn
if not compose_fn or not compose_path.is_file():
    raise SystemExit(4)

# Restore the selected snapshot.
(app_dir / "docker-compose.yml").write_text(compose_path.read_text(encoding="utf-8"), encoding="utf-8")

