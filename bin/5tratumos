#!/usr/bin/env bash
set -euo pipefail

legacy_brand() { printf '%s' f o r g e o s; }
legacy_upper() { printf '%s' F O R G E O S; }
legacy_env() {
  local suffix="$1"
  local k
  k="$(legacy_upper)_${suffix}"
  printf '%s' "${!k-}"
}

ROOT_DIR="${FIVETRATUMOS_ROOT:-$(legacy_env ROOT)}"
ROOT_DIR="${ROOT_DIR:-/opt/5tratumos}"
STATE_DIR="${FIVETRATUMOS_STATE_DIR:-$(legacy_env STATE_DIR)}"
STATE_DIR="${STATE_DIR:-/var/lib/5tratumos}"
CHANNEL_FILE="${FIVETRATUMOS_CHANNEL_FILE:-$(legacy_env CHANNEL_FILE)}"
CHANNEL_FILE="${CHANNEL_FILE:-/etc/5tratumos/channel}"
STORE_CONFIG_FILE="${FIVETRATUMOS_STORE_CONFIG_FILE:-/etc/5tratumos/store.json}"

die() {
  echo "error: $*" >&2
  exit 1
}

have() { command -v "$1" >/dev/null 2>&1; }

compose_project_containers() {
  local project="$1"
  docker ps -a --filter "label=com.docker.compose.project=${project}" --format '{{.ID}}' 2>/dev/null || true
}

compose_project_networks() {
  local project="$1"
  docker network ls --filter "label=com.docker.compose.project=${project}" --format '{{.ID}}' 2>/dev/null || true
}

compose_project_volumes() {
  local project="$1"
  docker volume ls --filter "label=com.docker.compose.project=${project}" --format '{{.Name}}' 2>/dev/null || true
}

force_stop_project() {
  local project="$1"
  local ids
  ids="$(compose_project_containers "${project}" | tr '\n' ' ' | xargs || true)"
  [ -n "${ids}" ] || return 0
  echo "warn: forcing containers down for project ${project}" >&2
  docker rm -f ${ids} >/dev/null 2>&1 || true
}

acquire_app_lock() {
  local app_id="$1"
  local lock_root="${STATE_DIR}/locks"
  local lock_dir="${lock_root}/${app_id}.lock"

  mkdir -p "${lock_root}" 2>/dev/null || true

  if mkdir "${lock_dir}" 2>/dev/null; then
    printf '%s\n' "$$" >"${lock_dir}/pid" 2>/dev/null || true
    date +%s >"${lock_dir}/started_at" 2>/dev/null || true
    # Expand the lock path now (while in scope). Using a local var in an EXIT trap with `set -u`
    # can fail later when the trap runs and the local is out of scope, leaving stale locks behind.
    trap "rm -rf '${lock_dir}' 2>/dev/null || true" EXIT
    return 0
  fi

  local pid started now age
  pid="$(cat "${lock_dir}/pid" 2>/dev/null || true)"
  started="$(cat "${lock_dir}/started_at" 2>/dev/null || true)"
  now="$(date +%s 2>/dev/null || echo 0)"
  age=0
  if [ -n "${started}" ] && [ "${now}" -gt 0 ] 2>/dev/null; then
    age="$((now - started))" || age=0
  fi

  if [ -n "${pid}" ] && kill -0 "${pid}" >/dev/null 2>&1; then
    die "app is busy: ${app_id} (operation in progress)"
  fi

  if [ "${age}" -gt 1800 ] 2>/dev/null || [ -z "${pid}" ]; then
    rm -rf "${lock_dir}" 2>/dev/null || true
    if mkdir "${lock_dir}" 2>/dev/null; then
      printf '%s\n' "$$" >"${lock_dir}/pid" 2>/dev/null || true
      date +%s >"${lock_dir}/started_at" 2>/dev/null || true
      trap "rm -rf '${lock_dir}' 2>/dev/null || true" EXIT
      return 0
    fi
  fi

  die "app is busy: ${app_id} (operation in progress)"
}

cleanup_project_artifacts() {
  local project="$1"
  local remove_volumes="${2:-false}"

  # Networks may be left behind if docker compose is interrupted.
  local nets
  nets="$(compose_project_networks "${project}" | tr '\n' ' ' | xargs || true)"
  if [ -n "${nets}" ]; then
    docker network rm ${nets} >/dev/null 2>&1 || true
  fi

  if [ "${remove_volumes}" = "true" ]; then
    local vols
    vols="$(compose_project_volumes "${project}" | tr '\n' ' ' | xargs || true)"
    if [ -n "${vols}" ]; then
      docker volume rm ${vols} >/dev/null 2>&1 || true
    fi
  fi
}

compose_down_safe() {
  local project="$1"
  local workdir="$2"
  local remove_volumes="${3:-false}"
  local args
  args=(down --remove-orphans)
  if [ "${remove_volumes}" = "true" ]; then
    args+=(--volumes)
  fi

  local rc=0
  if have timeout; then
    set +e
    (cd "${workdir}" && timeout 120s docker compose --project-name "${project}" "${args[@]}")
    rc=$?
    set -e
  else
    set +e
    (cd "${workdir}" && docker compose --project-name "${project}" "${args[@]}")
    rc=$?
    set -e
  fi

  # If compose failed or timed out, force stop remaining containers then clean up networks (and volumes if asked).
  if [ "${rc}" -ne 0 ]; then
    force_stop_project "${project}"
    cleanup_project_artifacts "${project}" "${remove_volumes}"
    return 0
  fi
  return 0
}

current_channel() {
  if [ -n "${FIVETRATUMOS_CHANNEL:-}" ]; then
    echo "${FIVETRATUMOS_CHANNEL}"
    return 0
  fi
  legacy_ch="$(legacy_env CHANNEL)"
  if [ -n "${legacy_ch}" ]; then
    echo "${legacy_ch}"
    return 0
  fi
  if [ -f "${CHANNEL_FILE}" ]; then
    tr -d ' \t\r\n' <"${CHANNEL_FILE}" || true
    return 0
  fi
  echo "main"
}

require_docker() {
  have docker || die "docker not found (install Docker Engine + Compose v2)"
  docker info >/dev/null 2>&1 || die "docker is not accessible (is the daemon running? permissions?)"
  docker compose version >/dev/null 2>&1 || die "docker compose not available (install docker-compose-plugin)"
}

ensure_dirs() {
  mkdir -p "${ROOT_DIR}/overlay" "${ROOT_DIR}/apps" "${ROOT_DIR}/apps-available"
  mkdir -p "${STATE_DIR}/apps"
}

compose_up() {
  local project="$1"
  local workdir="$2"
  shift 2
  if have timeout; then
    (cd "${workdir}" && timeout 600s docker compose --project-name "${project}" "$@")
  else
    (cd "${workdir}" && docker compose --project-name "${project}" "$@")
  fi
}

compose_up_app() {
  local project="$1"
  local workdir="$2"
  shift 2

  local out rc
  set +e
  if have timeout; then
    out="$(cd "${workdir}" && timeout 600s docker compose --project-name "${project}" "$@" 2>&1)"
  else
    out="$(cd "${workdir}" && docker compose --project-name "${project}" "$@" 2>&1)"
  fi
  rc=$?
  set -e
  printf '%s\n' "${out}"

  if [ "${rc}" -eq 0 ]; then
    return 0
  fi

  # Some apps use an "init" one-shot container that may race with already-running nodes during updates.
  # If init fails but all other services are running, keep the app in a "running" state instead of
  # surfacing a false failure (portal shows "Action failed" even though the app is up).
  if [ "${1:-}" = "up" ]; then
    if printf '%s\n' "${out}" | grep -qE "service ['\\\"]init['\\\"] didn'?t complete successfully|Error service ['\\\"]init['\\\"] didn'?t complete successfully"; then
      local services ok svc
      services="$(cd "${workdir}" && docker compose --project-name "${project}" config --services 2>/dev/null | grep -v '^init$' || true)"
      ok="true"
      for svc in ${services}; do
        if ! docker ps \
          --filter "label=com.docker.compose.project=${project}" \
          --filter "label=com.docker.compose.service=${svc}" \
          --filter "status=running" \
          --format '{{.ID}}' | grep -q .; then
          ok="false"
          break
        fi
      done
      if [ "${ok}" = "true" ]; then
        echo "warn: init failed but app services are running; ignoring init failure" >&2
        return 0
      fi
    fi
  fi

  return "${rc}"
}

ensure_app_env() {
  local app_id="$1"
  local app_dir="$2"
  local app_state_dir="${STATE_DIR}/apps/${app_id}"
  local project
  local env_file
  local tmp_file

  project="$(app_project_name "${app_id}")"
  env_file="${app_dir}/.env"
  tmp_file="$(mktemp)"

  if [ -f "${env_file}" ]; then
    awk -v app_data="${app_state_dir}" -v proj="${project}" '
      BEGIN { ad=0; pj=0; dd=0 }
      /^APP_DATA_DIR=/ { print "APP_DATA_DIR=" app_data; ad=1; next }
      /^DATADIR=/ { print "DATADIR=" app_data; dd=1; next }
      /^COMPOSE_PROJECT_NAME=/ { print "COMPOSE_PROJECT_NAME=" proj; pj=1; next }
      { print }
      END {
        if (ad == 0) print "APP_DATA_DIR=" app_data
        if (dd == 0) print "DATADIR=" app_data
        if (pj == 0) print "COMPOSE_PROJECT_NAME=" proj
      }
    ' "${env_file}" > "${tmp_file}"
  else
    printf "APP_DATA_DIR=%s\nDATADIR=%s\nCOMPOSE_PROJECT_NAME=%s\n" "${app_state_dir}" "${app_state_dir}" "${project}" > "${tmp_file}"
  fi

  mv -f "${tmp_file}" "${env_file}"
  chmod 600 "${env_file}" 2>/dev/null || true
}

app_meta_file() {
  local app_dir="$1"
  local new_path="${app_dir}/5tratumos.json"
  local legacy_path="${app_dir}/$(legacy_brand).json"
  if [ -f "${new_path}" ]; then
    echo "${new_path}"
    return 0
  fi
  if [ -f "${legacy_path}" ]; then
    echo "${legacy_path}"
    return 0
  fi
  echo "${new_path}"
}

app_project_name() {
  local app_id="$1"
  local new_project="5tratumos-${app_id}"
  local legacy_project="$(legacy_brand)-${app_id}"
  local bare_project="${app_id}"
  if docker ps -a --filter "label=com.docker.compose.project=${new_project}" --format '{{.ID}}' | grep -q .; then
    echo "${new_project}"
    return 0
  fi
  if docker ps -a --filter "label=com.docker.compose.project=${legacy_project}" --format '{{.ID}}' | grep -q .; then
    echo "${legacy_project}"
    return 0
  fi
  if docker ps -a --filter "label=com.docker.compose.project=${bare_project}" --format '{{.ID}}' | grep -q .; then
    echo "${bare_project}"
    return 0
  fi
  echo "${new_project}"
}

usage() {
  cat <<'EOF'
5tratumos: manage 5tratumOS overlay + AxeSuite apps (Docker Compose)

Usage:
  5tratumos channel get
  5tratumos channel set <main|dev>

  5tratumos store sync [main|dev|global|custom1|custom2|all]

  5tratumos overlay up
  5tratumos overlay down
  5tratumos overlay logs
  5tratumos overlay status

  5tratumos app available
  5tratumos app installed
  5tratumos app install <app-id> [--channel <main|dev|global|custom1|custom2>]
  5tratumos app update <app-id> [--channel <main|dev|global|custom1|custom2>]
  5tratumos app repair <app-id> [--channel <main|dev|global|custom1|custom2>]
  5tratumos app rollback <app-id> --to <version>
  5tratumos app uninstall <app-id> [--purge]
  5tratumos app up <app-id>
  5tratumos app down <app-id>
  5tratumos app pull <app-id>
  5tratumos app logs <app-id>
  5tratumos app fix-projects
EOF
}

cmd="${1:-}"
shift || true

case "${cmd}" in
  ""|-h|--help|help)
    usage
    exit 0
    ;;
esac

ensure_dirs

case "${cmd}" in
  channel)
    sub="${1:-}"; shift || true
    case "${sub}" in
      get)
        current_channel
        ;;
      set)
        [ "${EUID:-$(id -u)}" -eq 0 ] || die "channel set requires root (writes ${CHANNEL_FILE})"
        ch="${1:-}"
        [ -n "${ch}" ] || die "missing channel (main|dev)"
        case "${ch}" in
          main|dev) ;;
          *) die "invalid channel: ${ch} (expected main|dev)" ;;
        esac
        install -d -m 0755 "$(dirname "${CHANNEL_FILE}")"
        printf "%s\n" "${ch}" >"${CHANNEL_FILE}"
        echo "${ch}"
        ;;
      *)
        die "unknown subcommand: channel ${sub:-}"
        ;;
    esac
    ;;

  store)
    sub="${1:-}"; shift || true
    case "${sub}" in
      sync)
        [ "${EUID:-$(id -u)}" -eq 0 ] || die "store sync requires root (writes ${ROOT_DIR}/store)"
        have curl || die "curl not found (install curl)"
        have tar || die "tar not found"
        # Store repos are expected to be public; no token is required.
        # If a private store is ever used, reuse the OS update token.
        STORE_TOKEN_FILE="${FIVETRATUMOS_UPDATE_TOKEN_FILE:-/etc/5tratumos/update.token}"

        is_custom_slot() {
          local slot="${1:-}"
          [[ "${slot}" =~ ^custom[-_a-z0-9]{0,48}$ ]]
        }

        store_token() {
          [ -f "${STORE_TOKEN_FILE}" ] || return 0
          head -n 1 "${STORE_TOKEN_FILE}" 2>/dev/null | tr -d '\r\n' | cut -c1-4096
        }

        custom_store_slots() {
          python3 - "${STORE_CONFIG_FILE}" <<'PY'
import json
import sys

path = sys.argv[1] if len(sys.argv) > 1 else ""
try:
    data = json.load(open(path, "r", encoding="utf-8"))
except Exception:
    data = {}

custom = data.get("custom") if isinstance(data, dict) else {}
if not isinstance(custom, dict):
    sys.exit(0)

for key in sorted(custom.keys()):
    k = str(key or "").strip().lower()
    if not k.startswith("custom"):
        continue
    print(k)
PY
        }

        custom_store_url() {
          local slot="$1"
          python3 - "$slot" "${STORE_CONFIG_FILE}" <<'PY'
import json
import sys

slot = (sys.argv[1] if len(sys.argv) > 1 else "").strip().lower()
path = sys.argv[2] if len(sys.argv) > 2 else ""
if not slot or not path:
    sys.exit(0)
try:
    data = json.load(open(path, "r", encoding="utf-8"))
except Exception:
    data = {}
custom = data.get("custom") if isinstance(data, dict) else {}
entry = custom.get(slot) if isinstance(custom, dict) else None
if isinstance(entry, dict):
    url = str(entry.get("url") or "").strip()
    if url:
        print(url)
PY
        }

        resolve_store_url() {
          local raw="$1"
          python3 - "$raw" <<'PY'
import re
import sys

raw = (sys.argv[1] if len(sys.argv) > 1 else "").strip()
if not raw:
    sys.exit(0)

url = raw
fallback = ""

if not re.match(r"^https?://", url, re.I):
    if url.startswith("github.com/"):
        url = "https://" + url
    elif re.match(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", url):
        url = "https://github.com/" + url

if url.endswith(".git"):
    url = url[:-4]

m = re.match(r"^https?://github.com/([^/]+)/([^/]+?)(?:/|$)", url, re.I)
if m:
    owner, repo = m.group(1), m.group(2)
    branch = ""
    m2 = re.search(r"/tree/([^/]+)", url)
    if m2:
        branch = m2.group(1)
    if not branch:
        branch = "main"
        fallback = "master"
    elif branch == "main":
        fallback = "master"
    elif branch == "master":
        fallback = "main"
    url = f"https://github.com/{owner}/{repo}/archive/refs/heads/{branch}.tar.gz"
    if fallback:
        fallback = f"https://github.com/{owner}/{repo}/archive/refs/heads/{fallback}.tar.gz"

print(f"{url}|{fallback}")
PY
        }

        target="${1:-all}"
        case "${target}" in
          ""|all|main|dev|global) ;;
          custom*) ;;
          *) die "invalid store sync target: ${target} (expected main|dev|global|custom*|all)" ;;
        esac

        store_base="${ROOT_DIR}/store"
        mkdir -p "${store_base}"

        sync_one_github_private() {
          local ch="$1"
          local repo="$2"
          local ref="$3"
          local dest="${store_base}/${ch}"
          local tmp="${store_base}/.tmp-${ch}-$$"
          local tok
          tok="$(store_token)"
          [ -n "${tok}" ] || return 2
          rm -rf "${tmp}"
          mkdir -p "${tmp}"

          local api="https://api.github.com/repos/${repo}/tarball/${ref}"
          echo "syncing store (${ch})..."
          # Use --location-trusted so Authorization header is kept across redirects.
          if ! curl -fsSL --location-trusted \
            -H "Authorization: Bearer ${tok}" \
            -H "Accept: application/vnd.github+json" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            "${api}" | tar -xz -C "${tmp}" --strip-components=1; then
            rm -rf "${tmp}"
            return 1
          fi

          rm -rf "${dest}.bak" >/dev/null 2>&1 || true
          if [ -d "${dest}" ]; then
            mv "${dest}" "${dest}.bak" || true
          fi
          mv "${tmp}" "${dest}"
          rm -rf "${dest}.bak" >/dev/null 2>&1 || true
          return 0
        }

        sync_one() {
          local ch="$1"
          local url="$2"
          local url_fallback="${3:-}"
          local dest="${store_base}/${ch}"
          local tmp="${store_base}/.tmp-${ch}-$$"

          rm -rf "${tmp}"
          mkdir -p "${tmp}"

          echo "syncing store (${ch})..."
          if ! curl -fsSL "${url}" | tar -xz -C "${tmp}" --strip-components=1; then
            rm -rf "${tmp}"
            if [ -n "${url_fallback}" ]; then
              mkdir -p "${tmp}"
              echo "primary store URL failed; trying fallback..."
              if ! curl -fsSL "${url_fallback}" | tar -xz -C "${tmp}" --strip-components=1; then
                rm -rf "${tmp}"
                return 1
              fi
            else
              return 1
            fi
          fi

          # Normalize third-party manifests to a 5tratumOS-friendly name.
          find "${tmp}" -type f -name '*-app.yml' -print0 2>/dev/null | while IFS= read -r -d '' f; do
            [ "$(basename "${f}")" = "global-app.yml" ] && continue
            mv -f "${f}" "$(dirname "${f}")/global-app.yml" || true
          done

          rm -rf "${dest}"
          mv "${tmp}" "${dest}"
          return 0
        }

        sync_global_assets() {
          [ "${FIVETRATUMOS_GLOBAL_ASSETS_DISABLE:-}" = "1" ] && return 0
          local repo="${FIVETRATUMOS_GLOBAL_ASSETS_REPO:-}"
          repo="${repo:-$(legacy_env GLOBAL_ASSETS_REPO)}"
          repo="${repo:-WillItMod/global-apps-gallery}"
          local branch="${FIVETRATUMOS_GLOBAL_ASSETS_BRANCH:-}"
          branch="${branch:-$(legacy_env GLOBAL_ASSETS_BRANCH)}"
          branch="${branch:-master}"

          local url_default="https://github.com/${repo}/archive/refs/heads/${branch}.tar.gz"
          local url="${FIVETRATUMOS_GLOBAL_ASSETS_URL:-}"
          url="${url:-$(legacy_env GLOBAL_ASSETS_URL)}"
          url="${url:-${url_default}}"

          local url_fallback=""
          if [ -z "${FIVETRATUMOS_GLOBAL_ASSETS_URL:-}" ] && [ -z "$(legacy_env GLOBAL_ASSETS_URL)" ]; then
            if [ "${branch}" = "master" ]; then
              url_fallback="https://github.com/${repo}/archive/refs/heads/main.tar.gz"
            elif [ "${branch}" = "main" ]; then
              url_fallback="https://github.com/${repo}/archive/refs/heads/master.tar.gz"
            fi
          fi

          local ch="global-assets"
          local dest="${store_base}/${ch}"
          local tmp="${store_base}/.tmp-${ch}-$$"

          rm -rf "${tmp}"
          mkdir -p "${tmp}"

          echo "syncing store assets (${repo}@${branch})..."
          if ! curl -fsSL "${url}" | tar -xz -C "${tmp}" --strip-components=1; then
            [ -n "${url_fallback}" ] || die "failed to download global assets from ${url}"
            rm -rf "${tmp}"
            mkdir -p "${tmp}"
            echo "primary assets URL failed; trying fallback..."
            curl -fsSL "${url_fallback}" | tar -xz -C "${tmp}" --strip-components=1
          fi

          rm -rf "${dest}"
          mv "${tmp}" "${dest}"
        }

        main_repo="${FIVETRATUMOS_MAIN_STORE_REPO:-WillItMod/umbrel-community-store}"
        main_branch="${FIVETRATUMOS_MAIN_STORE_BRANCH:-main}"
        dev_repo="${FIVETRATUMOS_DEV_STORE_REPO:-WillItMod/umbrel-dev-community-store}"
        dev_branch="${FIVETRATUMOS_DEV_STORE_BRANCH:-main}"
        # Fallback to public tarball URLs if the repos are public.
        main_url="https://github.com/${main_repo}/archive/refs/heads/${main_branch}.tar.gz"
        main_url_fallback=""
        dev_url="https://github.com/${dev_repo}/archive/refs/heads/${dev_branch}.tar.gz"
        dev_url_fallback=""
        if [ "${main_branch}" = "main" ]; then
          main_url_fallback="https://github.com/${main_repo}/archive/refs/heads/master.tar.gz"
        elif [ "${main_branch}" = "master" ]; then
          main_url_fallback="https://github.com/${main_repo}/archive/refs/heads/main.tar.gz"
        fi
        if [ "${dev_branch}" = "main" ]; then
          dev_url_fallback="https://github.com/${dev_repo}/archive/refs/heads/master.tar.gz"
        elif [ "${dev_branch}" = "master" ]; then
          dev_url_fallback="https://github.com/${dev_repo}/archive/refs/heads/main.tar.gz"
        fi
        global_repo="${FIVETRATUMOS_GLOBAL_STORE_REPO:-}"
        global_repo="${global_repo:-$(legacy_env GLOBAL_STORE_REPO)}"
        global_repo="${global_repo:-WillItMod/global-apps}"
        global_branch="${FIVETRATUMOS_GLOBAL_STORE_BRANCH:-}"
        global_branch="${global_branch:-$(legacy_env GLOBAL_STORE_BRANCH)}"
        global_branch="${global_branch:-master}"
        global_url_default="https://github.com/${global_repo}/archive/refs/heads/${global_branch}.tar.gz"
        global_url="${FIVETRATUMOS_GLOBAL_STORE_URL:-}"
        global_url="${global_url:-$(legacy_env GLOBAL_STORE_URL)}"
        global_url="${global_url:-${global_url_default}}"
        global_url_fallback=""
        if [ -z "${FIVETRATUMOS_GLOBAL_STORE_URL:-}" ] && [ -z "$(legacy_env GLOBAL_STORE_URL)" ]; then
          if [ "${global_branch}" = "master" ]; then
            global_url_fallback="https://github.com/${global_repo}/archive/refs/heads/main.tar.gz"
          elif [ "${global_branch}" = "main" ]; then
            global_url_fallback="https://github.com/${global_repo}/archive/refs/heads/master.tar.gz"
          fi
        fi

        sync_one_repo() {
          local ch="$1"
          local repo="$2"
          local ref="$3"
          local url="$4"
          local url_fallback="${5:-}"
          if sync_one "${ch}" "${url}" "${url_fallback}"; then
            return 0
          fi
          # Public tarball failed (often a private repo). Try GitHub API tarball with a token if present.
          if sync_one_github_private "${ch}" "${repo}" "${ref}"; then
            return 0
          fi
          die "store sync failed for ${ch} (${repo}@${ref}). If this repo is private, set /etc/5tratumos/update.token and retry."
        }

        sync_custom() {
          local slot="$1"
          local raw
          raw="$(custom_store_url "${slot}")"
          [ -n "${raw}" ] || die "custom store not configured: ${slot}"
          local resolved
          resolved="$(resolve_store_url "${raw}")"
          IFS='|' read -r url url_fallback <<<"${resolved}"
          [ -n "${url}" ] || die "invalid custom store url for ${slot}"
          sync_one "${slot}" "${url}" "${url_fallback}" || die "failed to download custom store (${slot})"
        }

        if [ "${target}" = "all" ] || [ -z "${target}" ]; then
          sync_one_repo "main" "${main_repo}" "${main_branch}" "${main_url}" "${main_url_fallback}"
          sync_one_repo "dev" "${dev_repo}" "${dev_branch}" "${dev_url}" "${dev_url_fallback}"
          sync_one "global" "${global_url}" "${global_url_fallback}" || die "failed to download global store"
          while IFS= read -r slot; do
            [ -n "${slot}" ] || continue
            if is_custom_slot "${slot}"; then
              raw="$(custom_store_url "${slot}")"
              if [ -n "${raw}" ]; then
                sync_custom "${slot}"
              fi
            fi
          done < <(custom_store_slots)
          sync_global_assets
        elif [ "${target}" = "main" ]; then
          sync_one_repo "main" "${main_repo}" "${main_branch}" "${main_url}" "${main_url_fallback}"
        elif [ "${target}" = "dev" ]; then
          sync_one_repo "dev" "${dev_repo}" "${dev_branch}" "${dev_url}" "${dev_url_fallback}"
        elif [ "${target}" = "global" ]; then
          sync_one "global" "${global_url}" "${global_url_fallback}" || die "failed to download global store"
          sync_global_assets
        else
          is_custom_slot "${target}" || die "invalid custom store slot: ${target}"
          sync_custom "${target}"
        fi

        echo "store synced: ${store_base}"
        ;;
      *)
        die "unknown subcommand: store ${sub:-}"
        ;;
    esac
    ;;

  overlay)
    require_docker
    sub="${1:-}"; shift || true
    case "${sub}" in
      up)
        compose_up "5tratumos-overlay" "${ROOT_DIR}/overlay" up -d
        ;;
      down)
        compose_up "5tratumos-overlay" "${ROOT_DIR}/overlay" down
        ;;
      logs)
        compose_up "5tratumos-overlay" "${ROOT_DIR}/overlay" logs --tail=200 -f
        ;;
      status)
        compose_up "5tratumos-overlay" "${ROOT_DIR}/overlay" ps
        ;;
      *)
        die "unknown subcommand: overlay ${sub:-}"
        ;;
    esac
    ;;

  app)
    require_docker
    sub="${1:-}"; shift || true
    case "${sub}" in
      available)
        ch="$(current_channel)"
        avail_dir="${ROOT_DIR}/apps-available/${ch}"
        [ -d "${avail_dir}" ] || die "no available apps for channel '${ch}' in ${avail_dir}"
        (cd "${avail_dir}" && ls -1) || true
        ;;
      installed)
        (cd "${ROOT_DIR}/apps" && ls -1) || true
        ;;
      fix-projects)
        apps_dir="${ROOT_DIR}/apps"
        [ -d "${apps_dir}" ] || die "apps directory not found: ${apps_dir}"
        for app_dir in "${apps_dir}"/*; do
          [ -d "${app_dir}" ] || continue
          app_id="$(basename "${app_dir}")"
          [ -n "${app_id}" ] || continue
          app_state_dir="${STATE_DIR}/apps/${app_id}"
          project="$(app_project_name "${app_id}")"
          env_file="${app_dir}/.env"
          tmp_file="$(mktemp)"
          if [ -f "${env_file}" ]; then
            awk -v app_data="${app_state_dir}" -v proj="${project}" '
              BEGIN { ad=0; pj=0; dd=0 }
              /^APP_DATA_DIR=/ { print "APP_DATA_DIR=" app_data; ad=1; next }
              /^DATADIR=/ { print "DATADIR=" app_data; dd=1; next }
              /^COMPOSE_PROJECT_NAME=/ { print "COMPOSE_PROJECT_NAME=" proj; pj=1; next }
              { print }
              END {
                if (ad == 0) print "APP_DATA_DIR=" app_data
                if (dd == 0) print "DATADIR=" app_data
                if (pj == 0) print "COMPOSE_PROJECT_NAME=" proj
              }
            ' "${env_file}" > "${tmp_file}"
          else
            printf "APP_DATA_DIR=%s\nDATADIR=%s\nCOMPOSE_PROJECT_NAME=%s\n" "${app_state_dir}" "${app_state_dir}" "${project}" > "${tmp_file}"
          fi
          mv -f "${tmp_file}" "${env_file}"
          chmod 600 "${env_file}" 2>/dev/null || true
          printf "%s\t%s\n" "${app_id}" "${project}"
        done
        ;;
      install)
        app_id="${1:-}"; shift || true
        [ -n "${app_id}" ] || die "missing app id"
        acquire_app_lock "${app_id}"
        ch="$(current_channel)"
        if [ "${1:-}" = "--channel" ]; then
          shift
          ch="${1:-}"
          shift || true
        fi
        [ -n "${ch}" ] || die "missing channel value"
        store_root="${ROOT_DIR}/store/${ch}"
        store_dir=""
        store_port=""
        dst="${ROOT_DIR}/apps/${app_id}"
        if [ -e "${dst}" ]; then
          project="$(app_project_name "${app_id}")"
          if [ ! -f "${dst}/docker-compose.yml" ] && ! compose_project_containers "${project}" | grep -q .; then
            echo "warn: removing stale app directory before install: ${dst}" >&2
            rm -rf "${dst}" 2>/dev/null || true
          else
            die "app already installed: ${app_id} (${dst})"
          fi
        fi

        install -d -m 0755 "${dst}"

        src="${ROOT_DIR}/apps-available/${ch}/${app_id}"
        if [ -d "${src}" ]; then
          cp -a "${src}/." "${dst}/"
        else
          [ -d "${store_root}" ] || die "store not found: ${store_root} (run: sudo 5tratumos store sync ${ch})"

          resolved="$(
            TARGET_APP_ID="${app_id}" STORE_ROOT="${store_root}" python3 - <<'PY'
import os
import sys
from pathlib import Path

try:
    import yaml  # type: ignore
except Exception:
    print("", file=sys.stderr)
    sys.exit(2)

target = (os.environ.get("TARGET_APP_ID") or "").strip().lower()
root = Path(os.environ.get("STORE_ROOT") or "")
if not target or not root.is_dir():
    sys.exit(1)

def map_store_id_to_app_id(store_id: str) -> str:
    raw = (store_id or "").strip().lower()
    # Global/custom stores use canonical IDs like "bitcoin", "nextcloud", etc.
    if root.name.strip().lower().startswith("custom") or root.name.strip().lower() == "global":
        raw = raw.replace(" ", "-")
        raw = "".join(ch for ch in raw if ch.isalnum() or ch in {"_", "-"})
        return raw or "app"
    for prefix in ("willitmod-dev-", "willitmod-"):
        if raw.startswith(prefix):
            raw = raw[len(prefix) :]
            break
    raw = raw.replace("_", "").replace("-", "")
    if not raw.startswith("axe"):
        raw = f"axe{raw}"
    return raw

for entry in sorted(root.iterdir(), key=lambda p: p.name):
    if not entry.is_dir():
        continue
    if entry.name.startswith("."):
        continue
    manifest_path = entry / "global-app.yml"
    compose_path = entry / "docker-compose.yml"
    if not manifest_path.is_file() or not compose_path.is_file():
        continue
    try:
        manifest = yaml.safe_load(manifest_path.read_text(encoding="utf-8")) or {}
    except Exception:
        continue
    store_id = str(manifest.get("id") or entry.name)
    app_id = map_store_id_to_app_id(store_id)
    if app_id != target:
        continue
    port = manifest.get("port") or ""
    print(f"{entry.name}\t{port}")
    sys.exit(0)

sys.exit(1)
PY
