        ;;
      uninstall)
        app_id="${1:-}"; shift || true
        [ -n "${app_id}" ] || die "missing app id"
        purge="false"
        if [ "${1:-}" = "--purge" ]; then
          purge="true"
          shift || true
        fi
        app_dir="${FORGEOS_ROOT}/apps/${app_id}"
        [ -d "${app_dir}" ] || die "app not installed: ${app_id} (${app_dir})"

        project="forgeos-${app_id}"
        (cd "${app_dir}" && docker compose --project-name "${project}" down --remove-orphans) || true

        rm -rf "${app_dir}"
        if [ "${purge}" = "true" ]; then
          rm -rf "${FORGEOS_STATE_DIR}/apps/${app_id}"
          echo "uninstalled ${app_id} (purged)"
        else
          echo "uninstalled ${app_id}"
        fi
        ;;
      up|down|pull|logs)
        action="${sub}"
        app_id="${1:-}"; shift || true
        [ -n "${app_id}" ] || die "missing app id"
        app_dir="${FORGEOS_ROOT}/apps/${app_id}"
        [ -d "${app_dir}" ] || die "app not installed: ${app_id} (${app_dir})"
        case "${action}" in
          up)
            compose_up "forgeos-${app_id}" "${app_dir}" up -d
            ;;
          down)
            compose_up "forgeos-${app_id}" "${app_dir}" down
            ;;
          pull)
            compose_up "forgeos-${app_id}" "${app_dir}" pull
            ;;
          logs)
            compose_up "forgeos-${app_id}" "${app_dir}" logs --tail=200 -f
            ;;
        esac
        ;;
      *)
        die "unknown subcommand: app ${sub:-}"
        ;;
    esac
    ;;

  *)
    die "unknown command: ${cmd}"
    ;;
esac
