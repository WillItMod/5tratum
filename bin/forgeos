import json
import os
import time
from pathlib import Path

try:
    import yaml  # type: ignore
except Exception:
    yaml = None


def image_tag(image: str) -> str:
    raw = (image or "").strip()
    if not raw:
        return ""
    base = raw.split("@", 1)[0]
    idx = base.rfind(":")
    if idx <= base.rfind("/"):
        return ""
    tag = base[idx + 1 :].strip()
    if not tag or tag.lower() == "latest":
        return ""
    return tag


app_id = (os.environ.get("APP_ID") or "").strip().lower()
channel = (os.environ.get("CHANNEL") or "").strip().lower()
store_root = Path(os.environ.get("STORE_ROOT") or "")
store_dir = (os.environ.get("STORE_DIR") or "").strip()
app_dir = Path(os.environ.get("APP_DIR") or "")

manifest = {}
store_id = store_dir
installed_version = ""

if yaml is not None and store_root.is_dir() and store_dir:
    manifest_path = store_root / store_dir / "umbrel-app.yml"
    if manifest_path.is_file():
        try:
            manifest = yaml.safe_load(manifest_path.read_text(encoding="utf-8")) or {}
        except Exception:
            manifest = {}
        if isinstance(manifest, dict):
            store_id = str(manifest.get("id") or store_id)
            installed_version = str(manifest.get("version") or "") or installed_version

if not installed_version:
    compose_path = app_dir / "docker-compose.yml"
    if compose_path.is_file():
        if yaml is not None:
            try:
                compose = yaml.safe_load(compose_path.read_text(encoding="utf-8")) or {}
            except Exception:
                compose = {}
            services = compose.get("services") if isinstance(compose, dict) else {}
            if isinstance(services, dict):
                for name in ("app", "server", "web", "ui"):
                    svc = services.get(name)
                    if not isinstance(svc, dict):
                        continue
                    installed_version = image_tag(str(svc.get("image") or ""))
                    if installed_version:
                        break
                if not installed_version:
                    for svc in services.values():
                        if not isinstance(svc, dict):
                            continue
                        installed_version = image_tag(str(svc.get("image") or ""))
                        if installed_version:
                            break
        if not installed_version:
            for line in compose_path.read_text(encoding="utf-8", errors="ignore").splitlines():
                s = line.strip()
                if not s.startswith("image:"):
                    continue
                installed_version = image_tag(s.split(":", 1)[1].strip())
                if installed_version:
                    break

now = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
meta = {
    "app_id": app_id,
    "channel": channel,
    "store_dir": store_dir,
    "store_id": store_id,
    "installed_version": installed_version,
    "updated_at": now,
}
print(json.dumps(meta, separators=(",", ":"), ensure_ascii=False))
